# Lovable Cloud / Supabase (required for shared warehouse sync)
# Get these from Lovable → Cloud → Project settings / API keys
# Also add the same keys in Vercel → Project Settings → Environment Variables

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin console gate (/admin-unlock) — required on the server
# ADMIN_PASSWORD = the password you type on the unlock screen
# ADMIN_SESSION_SECRET = random string, at least 32 characters (cookie signing)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# After enabling Cloud, run the SQL in:
#   supabase/migrations/001_load_planner.sql
#   supabase/migrations/002_trips.sql
# via Cloud → SQL editor
